docker_image = docker://rykassab/datasail:1.3.0

executable = run_datasail_split.sh
# args: <technique> <sim_source> <split_spec>
#   technique  : C1e (cold-target split) | I1e (identity) | R (random baseline)
#   sim_source : mmseqs | mmseqs2 | cdhit | foldseek | diamond | <matrix.tsv>
#   split_spec : colon-separated fractions of what we want in the train/val/test splits

arguments  = C1e mmseqs2 0.7:0.15:0.15

transfer_input_files = clean.fasta

# DataSAIL writes splits, reports, and logs under output/ ; bring the dir back.
transfer_output_files = datasail_results_$(ClusterId).tar.gz
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

log    = datasail_$(Cluster).log
output = datasail_$(Cluster).$(Process).out
error  = datasail_$(Cluster).$(Process).err

request_cpus   = 4
request_memory = 8GB
request_disk   = 20GB

environment = "CLUSTER=$(Cluster) PROCESS=$(Process)"

# CHTC / restricted pools: execute nodes frequently CANNOT reach the internet.
# The live build (tier 3) will then fail. If so, use the conda-pack tarball
# (tier 2) or a container. You may also need a pool-specific attribute to get a
# node that permits outbound traffic — check CHTC docs.

queue 1


